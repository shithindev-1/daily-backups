# --- Server (read by `python -m app`, which the Windows service runs) ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Reverse-proxy IPs whose X-Forwarded-Proto/For headers are trusted (comma-separated, or *)
FORWARDED_ALLOW_IPS=127.0.0.1
# Swagger UI at /docs - set false on an internet-facing host
DOCS_ENABLED=true

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_TOKENS=2048
# Faster/cheaper model for the crop + rotation calls only (e.g. a Flash-Lite model); empty = GEMINI_MODEL
GEMINI_VISION_MODEL=
# Thinking tokens for self- and cross-verification; lower answers faster, too low may miss subtle problems
GEMINI_VERIFICATION_THINKING_BUDGET=256
GEMINI_TIMEOUT_SECONDS=105
GEMINI_MAX_IMAGE_EDGE=1568
REQUIRE_HTTPS=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_MB=15
DETECTION_ENABLED=true
VALIDATION_ENABLED=true
# Reuse a byte-identical file's extraction and passed self-check for this many seconds (memory only, 0 = off)
RESULT_CACHE_SECONDS=10800
DETECTION_OUTPUT_DIR=detections
DETECTION_PDF_DPI=200
DETECTION_CROP_PADDING_PX=10
DETECTION_CROP_PADDING_RATIO=0.015
DETECTION_CROP_TOP_PADDING_RATIO=0.015
DETECTION_ROTATION_MIN_CONFIDENCE=0.7
DETECTION_CROP_TARGET_LONG_EDGE=1600
DETECTION_CROP_SHARPEN_AMOUNT=0.4
# Contrast boost for faded scans; 0 = off (on printed cards it lifts the background pattern into noise)
DETECTION_CROP_CONTRAST_CLIP=0
# Stored originals/crops/merged PDFs (DETECTION_OUTPUT_DIR, LEASING_OUTPUT_DIR) are deleted after this many hours; 0 = keep forever
OUTPUT_RETENTION_HOURS=24
LOG_RETENTION_DAYS=30
# Folder for the rotating log files; empty = the project's logs/ folder
LOG_DIR=
# Writes extracted ID data (names, ID numbers, DOB) to logs/results.log - development only, keep false in production
LOG_EXTRACTED_RESULTS=false
# Output folder for the /ocr/leasing endpoints
LEASING_OUTPUT_DIR=postman_output
# Unrecognised country codes / nationalities are saved here and matched to an exact country name by Gemini
COUNTRY_LEARNING_ENABLED=true
COUNTRY_LEARNING_DIR=learned_countries

# --- Security ---
# Comma-separated keys accepted in the X-API-Key header on /api/v1 routes (empty = auth OFF, local testing only)
API_KEYS=
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:3000,https://app.example.com
CORS_ORIGINS=

# Azure Blob Storage for /ocr/leasing: sources fetched from, and <name>_ocr.<ext> results uploaded to, this container
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Extra hosts a /ocr/leasing source URL may point at, besides the blob container (comma-separated). Empty = blob container only
ALLOWED_SOURCE_HOSTS=
